{
  "name": "saci-web",
  "private": true,
  "version": "0.1.0",
  "description": "Midnight Saci web console: served by saci-backend at /ui/",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "api-types": "openapi-typescript ../docs/openapi.yaml -o src/api/schema.d.ts",
    "api-types:check": "openapi-typescript ../docs/openapi.yaml -o .api-types.check.d.ts && node scripts/same-file.mjs src/api/schema.d.ts .api-types.check.d.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run api-types:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
