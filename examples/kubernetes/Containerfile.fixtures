# Test fixtures for the namespace example (docs/namespace-workflows.md):
# the scripted model and the orders service, run as Deployments next to
# Saci. Not part of a Saci install.
#
#   docker build -f examples/kubernetes/Containerfile.fixtures -t localhost/saci-fixtures:latest .

ARG RUST_IMAGE=docker.io/library/rust:1.96-slim-trixie
ARG BASE_IMAGE=docker.io/library/debian:trixie-slim

FROM ${RUST_IMAGE} AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --release --package saci-testkit \
        --bin saci-fake-model --bin saci-fake-target \
    && install -D -t /out target/release/saci-fake-model target/release/saci-fake-target

FROM ${BASE_IMAGE}
COPY --from=build /out/ /usr/local/bin/
COPY examples/walkthrough/playbook.json /etc/saci-fixtures/playbook.json
USER 10001:0
