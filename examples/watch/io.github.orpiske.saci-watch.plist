<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for saci watch (docs/watch.md). Replace USER with your
     user name. Logs go to /tmp/saci-watch.log. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.orpiske.saci-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/saci</string>
    <string>watch</string>
    <string>--config</string>
    <string>/Users/USER/.config/saci/watch.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardErrorPath</key>
  <string>/tmp/saci-watch.log</string>
</dict>
</plist>
